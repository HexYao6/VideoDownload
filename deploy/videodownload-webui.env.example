# VideoDownload WebUI 的环境变量
#
# 复制到 /etc/videodownload-webui.env 并修改：
#   sudo cp deploy/videodownload-webui.env.example /etc/videodownload-webui.env
#   sudo chmod 600 /etc/videodownload-webui.env
#   sudo systemctl restart videodownload-webui
#
# 访问口令：局域网共享时建议设置，未设置则任何同网段设备都能访问并触发下载。
# 设置后访问 http://<本机IP>:8000/?token=<这里的口令> 即可。
VIDEODOWNLOAD_TOKEN=

# 也可以在这里放 cookies.txt 的路径（未设置时默认用项目根目录的 cookies.txt）
# VIDEODOWNLOAD_COOKIE_FILE=
